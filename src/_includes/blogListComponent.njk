{% macro createForLang(lang, collections) %}
<section class="container">
    {% if lang == "nl" %}
        <h2>Andere blogs die je misschien leuk vindt</h2>
        <div class="container">
            <div class="row">
                {% for blog in collections.dutchBlogs %}
                    <div class="col-12 col-md-6 col-lg-4 mb-4">
                        <div class="card h-100 p-1">
                            <a href="{{ blog.page.url }}">
                                <img alt="{{ blog.data.imgAlt }}"
                                     class="img-fluid card-img-top clickable-image img-thumbnail rounded-3 blog-thumbnail-image"
                                     src="https://softoft.sirv.com/gibs/{{ blog.data.mainImageName }}">
                            </a>
                            <div class="card-body">
                                <h5 class="card-title">{{ blog.data.title }}</h5>
                                <p class="card-text">{{ blog.data.description }}</p>
                                <a href="{{ blog.page.url }}" class="btn btn-primary">Lees meer</a>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    {% endif %}

    {% if lang == "en" %}
        <h2>Other blogs you might like</h2>
        <div class="container">
            <div class="row">
                {% for blog in collections.englishBlogs %}
                    <div class="col-12 col-md-6 col-lg-4 mb-4">
                        <div class="card h-100 p-1">
                            <a href="{{ blog.page.url }}">
                                <img alt="{{ blog.data.imgAlt }}"
                                     class="img-fluid card-img-top clickable-image img-thumbnail rounded-3 blog-thumbnail-image"
                                     src="https://softoft.sirv.com/gibs/{{ blog.data.mainImageName }}">
                            </a>
                            <div class="card-body">
                                <h5 class="card-title">{{ blog.data.title }}</h5>
                                <p class="card-text">{{ blog.data.description }}</p>
                                <a href="{{ blog.page.url }}" class="btn btn-primary">Read More</a>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>

    {% endif %}
    {% if lang == "de" %}
        <h2>Andere Blogs, die dir gefallen könnten</h2>
        <div class="container">
            <div class="row">
                {% for blog in collections.germanBlogs %}
                    <div class="col-12 col-md-6 col-lg-4 mb-4">
                        <div class="card h-100 p-1">
                            <a href="{{ blog.page.url }}">
                                <img alt="{{ blog.data.imgAlt }}"
                                     class="img-fluid card-img-top clickable-image img-thumbnail rounded-3 blog-thumbnail-image"
                                     src="https://softoft.sirv.com/gibs/{{ blog.data.mainImageName }}">
                            </a>
                            <div class="card-body">
                                <h5 class="card-title">{{ blog.data.title }}</h5>
                                <p class="card-text">{{ blog.data.description }}</p>
                                <a href="{{ blog.page.url }}" class="btn btn-primary">Mehr lesen</a>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    {% endif %}
</section>

{% endmacro %}